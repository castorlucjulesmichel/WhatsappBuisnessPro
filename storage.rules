rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn(){ return request.auth != null; }
    function admin(){ return signedIn() && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)); }
    function owner(uid){ return signedIn() && request.auth.uid == uid; }

    match /whatssap-business-pro/products/{uid}/{file} {
      allow read: if signedIn();
      allow write: if owner(uid) && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /whatssap-business-pro/clips/{uid}/{file} {
      allow read: if signedIn();
      allow write: if owner(uid) && request.resource.size < 80 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }
    match /whatssap-business-pro/avatars/{uid}/{file} {
      allow read: if signedIn();
      allow write: if owner(uid) && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /whatssap-business-pro/statuses/{uid}/{statusId}/{file} {
      allow read: if signedIn()
        && (
          owner(uid)
          || firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)/contacts/$(uid))
          || firestore.get(/databases/(default)/documents/statuses/$(statusId)).data.boostActive == true
        );
      allow write: if owner(uid)
        && request.resource.size < 80 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('video/.*'));
    }

    match /whatssap-business-pro/chat-media/{uid}/{chatId}/{file} {
      allow read: if signedIn()
        && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants;
      allow create: if owner(uid)
        && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants
        && request.resource.size < 25 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('audio/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('text/.*')
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
          || request.resource.contentType == 'application/vnd.ms-excel'
          || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
        );
      allow update: if false;
      allow delete: if owner(uid);
    }

    match /whatssap-business-pro/proofs/{uid}/{file} {
      allow read: if owner(uid) || admin();
      allow write: if owner(uid) && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /whatssap-business-pro/ad-proofs/{uid}/{file} {
      allow read: if owner(uid) || admin();
      allow write: if owner(uid) && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}