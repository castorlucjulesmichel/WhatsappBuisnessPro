rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function isAdmin(){ return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isSelf(uid){ return signedIn() && request.auth.uid == uid; }
    function userDoc(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function active(){ return signedIn() && userDoc().data.blocked != true; }
    function chatMember(chatId){ return active() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants; }
    function directChatBlocked(chatId){
      let p = get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      return p.size() == 2 && (
        exists(/databases/$(database)/documents/users/$(p[0])/blocks/$(p[1]))
        || exists(/databases/$(database)/documents/users/$(p[1])/blocks/$(p[0]))
      );
    }

    match /admins/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }

    match /users/{uid} {
      allow create: if isSelf(uid)
        && request.resource.data.blocked == false;
      allow read: if isSelf(uid) || isAdmin();
      allow update: if isAdmin()
        || (isSelf(uid)
          && request.resource.data.blocked == resource.data.blocked
          && request.resource.data.walletBalances == resource.data.walletBalances
          && request.resource.data.adBalances == resource.data.adBalances);
      allow delete: if false;

      match /contacts/{contactUid} {
        allow read: if isSelf(uid);
        allow create, update, delete: if isSelf(uid) && active();
      }

      match /blocks/{blockedUid} {
        allow read: if isSelf(uid);
        allow create, delete: if isSelf(uid) && active();
        allow update: if false;
      }
    }

    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid) && active();
      allow delete: if isSelf(uid) || isAdmin();
    }

    match /businesses/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid) && active();
      allow delete: if isSelf(uid) || isAdmin();
    }

    match /userSettings/{uid} {
      allow read, write: if isSelf(uid) && active();
      allow read: if isAdmin();
    }

    match /chats/{chatId} {
      allow create: if active()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 50;
      allow read: if chatMember(chatId);
      allow update: if chatMember(chatId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastMessage","updatedAt"]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if chatMember(chatId);
        allow create: if chatMember(chatId)
          && !directChatBlocked(chatId)
          && request.resource.data.senderId == request.auth.uid
          && (!("type" in request.resource.data)
              || request.resource.data.type in ["text","image","audio","document"])
          && (!("text" in request.resource.data)
              || (request.resource.data.text is string
                  && request.resource.data.text.size() <= 2000));
        allow update: if chatMember(chatId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy"])
          && request.auth.uid in request.resource.data.readBy;
        allow delete: if false;
      }

      match /typing/{uid} {
        allow read: if chatMember(chatId);
        allow create, update, delete: if chatMember(chatId) && request.auth.uid == uid;
      }
    }

    match /supportThreads/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, update: if (isSelf(uid) && active()) || isAdmin();
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create: if ((isSelf(uid) && active()) || isAdmin())
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }


    match /statuses/{id} {
      allow create: if active()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.boostActive == false;
      allow read: if signedIn() && (
        resource.data.ownerId == request.auth.uid
        || exists(/databases/$(database)/documents/users/$(resource.data.ownerId)/contacts/$(request.auth.uid))
        || resource.data.boostActive == true
      );
      allow update: if isAdmin()
        || (active()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.boostActive == resource.data.boostActive
          && request.resource.data.boostAudience == resource.data.boostAudience
          && request.resource.data.boostEndsAt == resource.data.boostEndsAt);
      allow delete: if isAdmin() || (active() && resource.data.ownerId == request.auth.uid);

      match /views/{viewerUid} {
        allow read: if resource.data.ownerId == request.auth.uid || isAdmin();
        allow create: if isSelf(viewerUid);
        allow update, delete: if false;
      }
    }

    match /products/{id} {
      allow read: if signedIn();
      allow create: if active() && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (active() && resource.data.sellerId == request.auth.uid);
    }

    match /orders/{id} {
      allow create: if active() && request.resource.data.buyerId == request.auth.uid;
      allow read: if isAdmin()
        || (signedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid));
      allow update: if isAdmin()
        || (active() && resource.data.sellerId == request.auth.uid
            && request.resource.data.buyerId == resource.data.buyerId
            && request.resource.data.sellerId == resource.data.sellerId
            && request.resource.data.total == resource.data.total);
      allow delete: if false;
    }

    match /shortVideos/{id} {
      allow read: if signedIn();
      allow create: if active() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (active() && resource.data.ownerId == request.auth.uid);
      match /likes/{uid} {
        allow read: if signedIn();
        allow create, delete: if isSelf(uid) && active();
        allow update: if false;
      }
    }

    match /financialRequests/{id} {
      allow create: if active() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /exchangeRequests/{id} {
      allow create: if active() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /walletTransactions/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /investmentLevels/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /investments/{id} {
      allow create: if active() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /adTopups/{id} {
      allow create: if active()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending";
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /adCampaigns/{id} {
      allow read: if signedIn();
      allow create: if active()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == "pending_review";
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /adMetrics/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }


    match /notifications/{id} {
      allow create: if isAdmin();
      allow read: if signedIn() && resource.data.recipientId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read","readAt"]);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.recipientId == request.auth.uid);
    }

    match /moderationCases/{id} {
      allow create: if active() && request.resource.data.reporterId == request.auth.uid;
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    match /adRequests/{id} {
      allow create: if active() && request.resource.data.userId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }
  }
}